# Copy this file to .env.docker. Never commit the real file.
YOUTUBE_API_KEY=replace_with_your_restricted_youtube_api_key
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=replace_with_your_google_web_client_id.apps.googleusercontent.com

# Password reset email. Keep PASSWORD_RESET_LOG_LINK=false in production.
FRONTEND_BASE_URL=https://analyzeytcomments.com
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_LOG_LINK=false
RESEND_API_KEY=replace_with_your_resend_sending_only_api_key
PASSWORD_RESET_FROM_EMAIL="CommentScope <no-reply@mail.analyzeytcomments.com>"

# Use the same value in both settings. For this local stack, use only letters
# and numbers so the password is also safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_long_alphanumeric_password
DATABASE_URL=postgresql+psycopg://youtube_app:replace_with_a_long_alphanumeric_password@db:5432/youtube_analyzer

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
