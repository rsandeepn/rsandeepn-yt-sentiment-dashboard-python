YOUTUBE_API_KEY=replace_with_your_restricted_api_key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL=postgresql+psycopg://youtube_app:change_this_password@localhost:5432/youtube_analyzer
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=replace_with_your_google_web_client_id.apps.googleusercontent.com
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Local-only option: logs the reset URL in the backend terminal instead of sending email.
# Never enable this in production.
PASSWORD_RESET_LOG_LINK=true
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
